# Required for the LLM tier. Without it the bot still runs, but only answers
# curated FAQs and links to the pages retrieval found.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults shown.
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=low
PORT=3000

# Comma-separated origins allowed to call /api/chat.
# Leave unset for local development (all origins allowed).
# In production set it, or any site can bill your API key:
ALLOWED_ORIGINS=https://lgu.edu.pk,https://www.lgu.edu.pk
