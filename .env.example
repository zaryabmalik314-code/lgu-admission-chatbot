# Required for the LLM tier. Without it the bot still runs, but only answers
# curated FAQs and links to the pages retrieval found.
ANTHROPIC_API_KEY=sk-ant-...

# Model. Default is claude-haiku-4-5 — the cheapest option and a good fit here,
# because retrieval has already found the answer and the model's job is to
# reformat it into the student's language rather than to reason.
#   claude-haiku-4-5  ~0.43c/question   (default)
#   claude-sonnet-5   ~1.3c/question
#   claude-opus-5     ~2.1c/question
CLAUDE_MODEL=claude-haiku-4-5

# Thinking depth. Ignored on models that don't support it (e.g. Haiku 4.5).
CLAUDE_EFFORT=low

# How many knowledge-base chunks to send as context. This is the biggest input
# cost after the model choice. Below 5, the combined fee-structure page starts
# dropping out of range on program-specific fee questions.
RETRIEVE_K=6

PORT=3000

# Comma-separated origins allowed to call /api/chat.
# Leave unset for local development (all origins allowed).
# In production set it, or any site can bill your API key:
ALLOWED_ORIGINS=https://lgu.edu.pk,https://www.lgu.edu.pk
