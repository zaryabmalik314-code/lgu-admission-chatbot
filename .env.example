# ── Provider ────────────────────────────────────────────────────────────
# "groq" (default), "gemini", or "anthropic". Everything else stays the same,
# so you can switch to compare answer quality on the same questions.
#
# Only the selected provider's key is needed. Cost/limits at a glance:
#   gemini  ~1,500 requests/day FREE, no card — cheapest to run
#   groq    100k tokens/day free (~40 questions); paid Dev tier is pay-per-token
#   anthropic  quality benchmark, paid
LLM_PROVIDER=groq

# ── Gemini (only used when LLM_PROVIDER=gemini) ─────────────────────────
# Key (free, no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=...
# gemini-2.5-flash (default) or gemini-2.5-flash-lite (faster/cheaper).
GEMINI_MODEL=gemini-2.5-flash

# ── Groq ────────────────────────────────────────────────────────────────
# Key: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Check https://console.groq.com/docs/models for the current list — Groq
# retires model IDs fairly often, and a stale ID fails at request time.
#   llama-3.3-70b-versatile   general default
#   qwen/qwen3-32b            usually the strongest on Urdu / Roman Urdu
#   llama-3.1-8b-instant      cheapest and fastest, weakest on Urdu
GROQ_MODEL=llama-3.3-70b-versatile

# ── Anthropic (only used when LLM_PROVIDER=anthropic) ───────────────────
# Key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_EFFORT=low

# ── Retrieval ───────────────────────────────────────────────────────────
# How many knowledge-base chunks to send as context. This is the biggest input
# cost after the model choice. Below 5, the combined fee-structure page starts
# dropping out of range on program-specific fee questions.
RETRIEVE_K=6

# ── Rate limiting ───────────────────────────────────────────────────────
# Keyed on a browser session id, never on IP — the whole campus shares one
# NAT address, so an IP bucket would lock out everyone on the wifi together.
RATE_SESSION_MAX=20
RATE_SESSION_WINDOW_S=300

# The ceiling that actually protects the API bill, since session ids are
# client-generated and therefore spoofable.
RATE_GLOBAL_MAX=500
RATE_GLOBAL_WINDOW_S=3600

# ── Server ──────────────────────────────────────────────────────────────
PORT=3000

# Comma-separated origins allowed to call /api/chat.
# Leave unset for local development (all origins allowed).
# In production set it, or any site can spend your API quota:
ALLOWED_ORIGINS=https://lgu.edu.pk,https://www.lgu.edu.pk
